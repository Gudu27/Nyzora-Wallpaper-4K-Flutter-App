/// Copy this file to `env.dart` in the same folder and add your API keys.
///
///   cp lib/core/constants/env.dart.example lib/core/constants/env.dart
///
/// Priority at runtime:
/// 1. `--dart-define=UNSPLASH_KEY=...` / `WALLHAVEN_KEY=...` (CI / release)
/// 2. Values in `env.dart` (local development)
///
/// Never commit `env.dart` with real keys (it is gitignored).

abstract final class EnvKeys {
  static const String unsplashKey = 'YOUR_UNSPLASH_ACCESS_KEY';
  static const String wallhavenKey = 'YOUR_WALLHAVEN_API_KEY';
}
